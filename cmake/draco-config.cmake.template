@PACKAGE_INIT@

if(TARGET draco_core)
    set(draco_illixr_FOUND TRUE)
    return()
endif()

set(_drc_targets "${CMAKE_CURRENT_LIST_DIR}/draco_illixr-targets.cmake")
if(NOT EXISTS "${_drc_targets}")
    set(draco_illixr_FOUND FALSE)
    unset(_drc_targets)
    return()
endif()

include("${_drc_targets}")
unset(_drc_targets)
